# 复制本文件为 keystore.properties 后填入自己的签名信息。
#
#   cp keystore.properties.example keystore.properties
#
# 生成一个自己的密钥库（有效期内可反复用于覆盖安装）：
#
#   keytool -genkeypair -v -keystore beacon-dmr.jks -alias beacon-dmr \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# 不填也能构建：app/build.gradle 检测到本文件缺失时会自动跳过签名，
# 产出未签名的 release 包（可用于调试，不能直接安装到手机）。

storeFile=beacon-dmr.jks
storePassword=你的密钥库口令
keyAlias=beacon-dmr
keyPassword=你的密钥口令
