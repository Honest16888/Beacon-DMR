<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 无 ActionBar，浅色底：WebView 首帧前不会闪黑 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/panel_light</item>
        <item name="android:navigationBarColor">@color/panel_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
