<?xml version="1.0" encoding="utf-8"?>
<!--
  浅色色板（l_ 前缀）与深色色板（d_ 前缀）都放在 values/ 里，
  **不用 -night 限定符** —— 限定符只能跟着系统走，而「设置 → 外观」
  允许用户强制浅色 / 强制深色，那两种组合跟系统开关无关。

  跟随系统那一档由 values-night/themes.xml 覆盖 AppTheme 实现。

  配色取自 WebView 版 web/index.html 的 :root 与 html[data-theme=dark]
  两组变量，两个版本并排装着看观感要一致。
-->
<resources>
    <!-- ==================== 浅色 ==================== -->
    <color name="l_bg">#eef1f5</color>
    <color name="l_panel">#ffffff</color>
    <color name="l_panel2">#f7f9fb</color>
    <color name="l_border">#dde3ea</color>
    <color name="l_text">#12161c</color>
    <color name="l_muted">#67707e</color>
    <color name="l_dim">#93a0b0</color>
    <color name="l_accent">#0b6bcb</color>
    <color name="l_accent_weak">#e6f0fb</color>
    <color name="l_ok">#12a150</color>
    <color name="l_warn">#d9822b</color>
    <color name="l_bad">#c22a2f</color>

    <!-- ==================== 深色 ==================== -->
    <color name="d_bg">#0f1216</color>
    <color name="d_panel">#171b21</color>
    <color name="d_panel2">#1e232b</color>
    <color name="d_border">#2a313b</color>
    <color name="d_text">#e8edf4</color>
    <color name="d_muted">#8d97a5</color>
    <color name="d_dim">#66707e</color>
    <color name="d_accent">#4da3ff</color>
    <color name="d_accent_weak">#16304a</color>
    <color name="d_ok">#3dd68c</color>
    <color name="d_warn">#f0a44a</color>
    <color name="d_bad">#ff7b80</color>

    <!-- ==================== 与主题无关 ==================== -->
    <!-- 启动图标渐变。和 WebView 版保持一致，两个 App 并排装在桌面上
         不能一个蓝一个别的色。 -->
    <color name="ic_bg_start">#FF2E86E0</color>
    <color name="ic_bg_end">#FF0A4E96</color>
</resources>
