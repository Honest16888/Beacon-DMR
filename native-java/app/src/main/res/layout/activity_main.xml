<?xml version="1.0" encoding="utf-8"?>
<!--
  壳：顶栏 + 三页 + 底栏。

  三页一次性全部 inflate（不用 Fragment），切页就是 setVisibility ——
  零依赖工程里最省事的做法，而且看板/设置的控件始终存在，
  切回来不用重建、不会丢滚动位置。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/cBg"
    android:fitsSystemWindows="true">

    <!-- ============ 顶栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textColor="?attr/cText"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <View
                    android:id="@+id/dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/stateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/state_idle"
                    android:textColor="?attr/cMuted"
                    android:textSize="11.5sp" />

                <View
                    android:id="@+id/dotLive"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/liveState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="活动 —"
                    android:textColor="?attr/cMuted"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnMute"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/mute"
            android:textSize="13sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- ============ 三页 ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageListen"
            layout="@layout/page_listen" />

        <include
            android:id="@+id/pageDash"
            layout="@layout/page_dash" />

        <include
            android:id="@+id/pageSettings"
            layout="@layout/page_settings" />
    </FrameLayout>

    <!-- ============ 底栏 ============ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/cBorder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/cPanel">

        <Button
            android:id="@+id/tabListen"
            style="@style/TabButton"
            android:text="🎧 主页" />

        <Button
            android:id="@+id/tabDash"
            style="@style/TabButton"
            android:text="📊 看板" />

        <Button
            android:id="@+id/tabSettings"
            style="@style/TabButton"
            android:text="⚙️ 设置" />
    </LinearLayout>
</LinearLayout>
