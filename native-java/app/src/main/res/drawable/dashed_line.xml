<?xml version="1.0" encoding="utf-8"?>
<!--
  「收起操作区」按钮上方那条虚线（.htfold{border-top:1px dashed var(-border2)}）。

  Android 的 shape 只能整圈描边，没有「只画上边」。这里配合 1dp 高的 View 用：
  高度 1dp 时上下边重合、左右边只剩 1px 的点，实际看到的就是一条虚线段。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="?attr/cBorder2"
        android:dashWidth="4dp"
        android:dashGap="3dp" />
</shape>
