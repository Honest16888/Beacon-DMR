<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮 PTT 钮（待命态）。

  WebView 版是一颗 radial-gradient 圆钮：
    radial-gradient(circle at 50% 34%, #ff6b6f, #d93b40 72%)
  Android 的 radial 渐变换成同样的圆心与半径就能对上 —— 亮部偏上 1/3，
  看起来像被顶光照着，和纯色比明显更有「按得下去」的实体感。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="72%p"
        android:centerX="0.5"
        android:centerY="0.34"
        android:startColor="#ff6b6f"
        android:endColor="#d93b40" />
</shape>
