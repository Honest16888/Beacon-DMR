<?xml version="1.0" encoding="utf-8"?>
<!--
  分段控件容器（顶栏「主页/看板/设置」、网络切换「国际 BM/国内 DMR」共用）。

  对应 WebView 版 .viewtabs / .seg：
    display:flex; gap:3px; background:var(-bg); border:1px solid var(-border);
    border-radius:10px; padding:3px
  选中那一颗另外套 bg_seg_on（见该文件）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/cBg" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="?attr/cBorder" />
</shape>
