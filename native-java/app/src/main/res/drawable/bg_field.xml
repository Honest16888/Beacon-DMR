<?xml version="1.0" encoding="utf-8"?>
<!--
  发射条里的输入框（话组号、DMR ID、主站）。

  对应 .ptxtg / .ptxin：background:var(-bg); border:1px solid var(-border);
  border-radius:8px。注意是 **cBg 而不是 cPanel2** —— 它压在 cPanel 色的
  发射条上，用比发射条更暗的底色才显得「凹进去」。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/cBg" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="?attr/cBorder" />
</shape>
